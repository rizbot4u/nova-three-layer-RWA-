"""
Layer 3 — settlement service.

Executes on-chain token transfers from the treasury wallet to a
verified investor. Called by the escrow router after all invariants
have been checked (KYC, supply cap, order state).

Reads:
  BASE_RPC_URL          — RPC endpoint (defaults to mainnet.base.org)
  TREASURY_PRIVATE_KEY  — the treasury signing key (0x...)
  TREASURY_WALLET_ADDRESS — optional; derived from key if unset
"""
import os
from typing import Optional

from web3 import Web3

BASE_RPC_URL = os.getenv("BASE_RPC_URL", "https://mainnet.base.org")
CHAIN_ID = 8453  # Base Mainnet

ERC20_TRANSFER_ABI = [
    {
        "constant": False,
        "inputs": [
            {"name": "_to", "type": "address"},
            {"name": "_value", "type": "uint256"},
        ],
        "name": "transfer",
        "outputs": [{"name": "", "type": "bool"}],
        "type": "function",
    }
]


class SettlementService:
    def __init__(self):
        self.w3 = Web3(Web3.HTTPProvider(BASE_RPC_URL))
        self.private_key = os.getenv("TREASURY_PRIVATE_KEY", "")
        if self.private_key:
            if not self.private_key.startswith("0x"):
                self.private_key = "0x" + self.private_key
            self.treasury = self.w3.eth.account.from_key(self.private_key).address
        else:
            self.treasury = os.getenv("TREASURY_WALLET_ADDRESS", "")

    def is_configured(self) -> bool:
        return bool(self.private_key) and bool(self.treasury)

    def send_shares(
        self,
        property_contract: str,
        to_wallet: str,
        amount: int,
    ) -> str:
        """
        Send `amount` shares from the treasury wallet to `to_wallet`.

        Returns the transaction hash (hex).
        Raises RuntimeError on any failure.
        """
        if not self.is_configured():
            raise RuntimeError("Treasury key not configured")

        contract = self.w3.eth.contract(
            address=Web3.to_checksum_address(property_contract),
            abi=ERC20_TRANSFER_ABI,
        )

        nonce = self.w3.eth.get_transaction_count(self.treasury)
        gas_price = self.w3.eth.gas_price

        txn = contract.functions.transfer(
            Web3.to_checksum_address(to_wallet),
            int(amount),
        ).build_transaction({
            "chainId": CHAIN_ID,
            "gas": 150_000,
            "gasPrice": gas_price,
            "nonce": nonce,
        })

        signed = self.w3.eth.account.sign_transaction(txn, private_key=self.private_key)
        tx_hash = self.w3.eth.send_raw_transaction(signed.rawTransaction)
        return self.w3.to_hex(tx_hash)


settlement_service = SettlementService()
