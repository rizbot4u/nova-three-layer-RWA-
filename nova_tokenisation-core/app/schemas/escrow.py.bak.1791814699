from datetime import datetime
from typing import Optional
from uuid import UUID

from pydantic import BaseModel, Field


class EscrowCreateRequest(BaseModel):
    investor_wallet: str = Field(..., description="Investor EVM wallet address (0x...)")
    property_contract: str = Field(..., description="Deployed NovaPropertyShare address")
    share_amount: int = Field(..., gt=0, description="Number of shares to purchase")
    price_per_share_usd: float = Field(..., gt=0, description="Price per share in USD")


class EscrowActionResponse(BaseModel):
    order_id: UUID
    state: str
    message: str
    settlement_tx_hash: Optional[str] = None
    updated_at: datetime

    class Config:
        from_attributes = True


class EscrowDetail(BaseModel):
    order_id: UUID
    investor_wallet: str
    property_contract: str
    share_amount: int
    total_usd: float
    state: str
    deposit_tx_hash: Optional[str] = None
    settlement_tx_hash: Optional[str] = None
    created_at: datetime
    updated_at: datetime

    class Config:
        from_attributes = True
